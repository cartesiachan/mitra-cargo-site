---
import Base from '../layouts/Base.astro';
import CekOngkir from '../components/CekOngkir.astro';
import Icon from '../components/Icon.astro';
import konten from '../data/konten.json';
import kontak from '../data/kontak.json';
const brand = konten.brand;
const waNum = (region: string) => kontak.marketing_wilayah.find((m) => m.region === region)?.nomor_intl ?? kontak.whatsapp_umum_intl;
const waHero = `https://wa.me/${kontak.whatsapp_umum_intl}?text=${encodeURIComponent(`Halo ${brand}, ${konten.wa.penawaranHero}`)}`;
const waKonsultasi = `https://wa.me/${kontak.whatsapp_umum_intl}?text=${encodeURIComponent(`Halo ${brand}, ${konten.wa.konsultasi}`)}`;
---
<Base seoKey="home">
<main id="beranda">
<section class="hero" data-astro="static" data-astro-label="STATIC · 0 JS" style="padding-top:56px">
  <div class="wrap hero-grid">
    <div>
      <p class="eyebrow">{konten.hero.eyebrow}</p>
      <h1>{konten.hero.titleBefore}<em>{konten.hero.titleEm}</em>{konten.hero.titleAfter}</h1>
      <p class="lead">{konten.hero.lead}</p>
      <div class="hero-actions">
        <a class="btn" href={waHero} target="_blank" rel="noopener">{konten.hero.btnWa}</a>
        <a class="btn btn-outline" href="#layanan" style="background:transparent;color:#fff;border-color:#94a3b8">{konten.hero.btnLayanan}</a>
      </div>
      <div class="hero-chips">
        {konten.hero.chips.map((chip) => (<span class="chip">{chip}</span>))}
      </div>
    </div>
    <figure class="routemap" aria-label="Peta Indonesia dengan rute pengiriman dari Jakarta">
