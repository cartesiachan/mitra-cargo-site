    <span class="pill">1 island: Cek Ongkir</span>
  </div>
</div>

<!-- TOOLS -->


<!-- USP -->
<section data-astro="static" data-astro-label="STATIC · 0 JS">
  <div class="wrap">
    <p class="eyebrow reveal">Kenapa {brand}</p>
    <h2 class="reveal">{konten.usp.title}</h2>
    <div class="usp-grid">
      {konten.usp.items.map((item) => (
      <div class="card reveal">
        <span class="icon" aria-hidden="true"><Icon name={item.icon} /></span>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </div>
      ))}
    </div>
  </div>
</section>

<!-- ABOUT -->
<section class="alt" id="tentang" data-astro="static" data-astro-label="STATIC · 0 JS">
  <div class="wrap">
    <div class="about-grid">
      <div class="reveal">
        <p class="eyebrow">{konten.about.eyebrow}</p>
        <h2>{konten.about.title}</h2>
        <p class="sub" style="margin-top:10px">{konten.about.para1}</p>
        <p class="sub" style="margin-top:10px">{konten.about.para2}</p>
        <div class="trust">
          {konten.about.trust.map((t) => (<div><b>{t.title}</b>{t.text}</div>))}
        </div>
      </div>
      <figure class="about-photo reveal">
        <img src={konten.about.photo.src} alt={konten.about.photo.alt} loading="lazy">
        <figcaption>{konten.about.photo.caption}</figcaption>
      </figure>
      <div class="about-visual reveal">
        <h3>{konten.about.visualTitle}</h3>
        <ul>
          {konten.about.visualItems.map((item) => (<li><b>{item.b}</b> {item.text}</li>))}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section id="layanan" data-astro="static" data-astro-label="STATIC · 0 JS">
  <div class="wrap">
    <p class="eyebrow reveal">{konten.services.eyebrow}</p>
    <h2 class="reveal">{konten.services.title}</h2>
    <p class="sub reveal">{konten.services.sub}</p>
    <p class="photo-note">{konten.services.photoNote}</p>
    <div class="services-grid">
      {konten.services.items.map((s) => (
      <article class="card service reveal">
        <div class="service-photo"><img src={s.photo} alt={s.photoAlt} loading="lazy"></div>
        <span class="icon" aria-hidden="true"><Icon name={s.icon} /></span>
        <p class="mode">{s.mode}</p>
        <h3>{s.title}</h3>
        <p class="cities">{s.cities}</p>
        <a class="btn btn-outline" href={`https://wa.me/${waNum(s.waRegion)}?text=${encodeURIComponent(s.waText)}`} target="_blank" rel="noopener">{s.btnLabel}</a>
      </article>
      ))}
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="process" data-astro="static" data-astro-label="STATIC · 0 JS">
  <div class="wrap">
    <p class="eyebrow reveal">{konten.process.eyebrow}</p>
    <h2 class="reveal">{konten.process.title}</h2>
    <p class="sub reveal">{konten.process.sub}</p>
    <div class="steps">
      {konten.process.steps.map((step, i) => (
      <div class="step reveal"><b class="num">{String(i + 1).padStart(2, '0')}</b><h3>{step.title}</h3><p>{step.text}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- WHY -->
<section data-astro="static" data-astro-label="STATIC · 0 JS">
  <div class="wrap">
    <div class="why-top">
      <div class="why-text">
        <p class="eyebrow reveal">{konten.why.eyebrow}</p>
        <h2 class="reveal">{konten.why.title}</h2>
        <p class="sub reveal">{konten.why.sub}</p>
        <div class="why-pills reveal">
          {konten.why.pills.map((pill) => (<span class="pill-red">{pill}</span>))}
        </div>
        <p class="photo-note reveal">{konten.why.note}</p>
      </div>
      <div class="collage reveal">
        {konten.why.collage.map((img) => (<figure class={img.tall ? 'col-tall' : undefined}><img src={img.src} alt={img.alt} loading="lazy"></figure>))}
      </div>
    </div>
    <div class="why-grid">
      {konten.why.cards.map((card) => (
      <div class="card why reveal">
        <span class="icon" aria-hidden="true"><Icon name={card.icon} /></span>
        <div><h3>{card.title}</h3><p>{card.text}</p></div>
      </div>
      ))}
    </div>
  </div>
</section>


<section class="alt" id="testimoni" data-astro="static" data-astro-label="STATIC · 0 JS">
  <div class="wrap">
    <p class="eyebrow reveal">{konten.testimonials.eyebrow}</p>
    <h2 class="reveal">{konten.testimonials.title}</h2>
    <p class="sub reveal">{konten.testimonials.intro}</p>
    <div class="testi-grid">
      {konten.testimonials.items.map((t) => (
      <div class="card reveal">
        <p class="quote">“{t.quote}”</p>
        <div class="who"><span class="avatar">{t.initials}</span><span><b>{t.name}</b><span>{t.route}</span></span></div>
      </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section data-astro="static" data-astro-label="STATIC · 0 JS">
  <div class="wrap faq">
    <p class="eyebrow reveal" style="text-align:center">{konten.faq.eyebrow}</p>
    <h2 class="reveal" style="text-align:center;margin-bottom:24px">{konten.faq.title}</h2>
    {konten.faq.items.map((item) => (<details class="reveal"><summary>{item.q}</summary><p>{item.a}</p></details>))}
  </div>
</section>

<!-- CTA + CONTACT -->
<section class="cta" id="kontak" style="padding-bottom:32px" data-astro="static" data-astro-label="STATIC · 0 JS">
  <div class="wrap">
    <h2 class="reveal">{konten.cta.title}</h2>
    <p class="reveal">{konten.cta.text}</p>
    <a class="btn btn-green" href={waKonsultasi} target="_blank" rel="noopener">Chat WhatsApp — {kontak.whatsapp_umum}</a>
    <a class="btn" href={`tel:${kontak.call_center_intl}`} style="margin-left:8px">Telepon {kontak.call_center}</a>
  </div>
</section>

<section style="padding-top:32px" data-astro="static" data-astro-label="STATIC · 0 JS">
  <div class="wrap contact-grid">
    <div class="card contact-box">
      <h3>{konten.contact.marketingTitle}</h3>
      {kontak.marketing.map((m) => (<p><b>{m.wilayah}</b><br><a href={`https://wa.me/${m.nomor_intl}`} target="_blank" rel="noopener">{m.nomor}</a></p>))}
    </div>
    <div class="card contact-box">
      <h3>{konten.contact.kantorTitle}</h3>
      <p>{kontak.alamat}</p>
      <p><b>Email:</b> <a href={`mailto:${kontak.email}`}>{kontak.email}</a></p>
      <p><b>Jam operasional:</b> {kontak.jam}</p>
    </div>
    <div class="card contact-box">
      <h3>{konten.contact.layananTitle}</h3>
      <p>{konten.contact.layananText1}</p>
      <p>{konten.contact.layananText2}</p>
    </div>
  </div>
</section>
