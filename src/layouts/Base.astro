---
import type { SiteData } from '../lib/db';
import { resolveTema, resolveOverlay, resolvePengumuman, temaBodyStyle } from '../lib/tema';
interface Props { seoKey: 'home' | 'harga'; data: SiteData; }
const { seoKey, data } = Astro.props;
const { konten, kontak, seo } = data;
const tema = resolveTema(konten.tema);
const peng = resolvePengumuman(konten.pengumuman);
const bodyStyle = temaBodyStyle(tema);
const page = seo[seoKey];
const brand = konten.brand;
const waUmum = `https://wa.me/${kontak.whatsapp_umum_intl}?text=${encodeURIComponent(`Halo ${brand}, ${konten.wa.penawaran}`)}`;
const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{page.title}</title>
<meta name="description" content={page.description}>
<meta property="og:type" content="website">
<meta property="og:title" content={page.ogTitle}>
<meta property="og:description" content={page.ogDescription}>
{page.ogImage && <meta property="og:image" content={page.ogImage}>}
{page.ogImage && <meta name="twitter:card" content="summary_large_image">}
{seo.gscVerification && <meta name="google-site-verification" content={seo.gscVerification}>}
{seo.ga4Id && <script async src={`https://www.googletagmanager.com/gtag/js?id=${seo.ga4Id}`}></script>}
{seo.ga4Id && <script set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${seo.ga4Id}');`}></script>}
<style is:global>
/* Gagian Cargo — Astro build (from approved v3 preview). Global styles. */
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Arial,Helvetica,sans-serif;color:#111;background:#fff;line-height:1.6}
a{color:inherit}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px}
h1,h2,h3{line-height:1.25}
h2{font-size:30px;margin-bottom:8px}
.eyebrow{color:var(--brand);font-weight:700;font-size:13px;letter-spacing:.12em;text-transform:uppercase;margin-bottom:8px}
/* READABILITY FIX 13 Nov: dark-red eyebrow is unreadable on dark navy sections (hero, process) — use yellow there */
.hero .eyebrow,.process .eyebrow{color:var(--aksen)}
.sub{color:#444;max-width:720px}
:focus-visible{outline:3px solid var(--brand);outline-offset:2px}
button{cursor:pointer;font:inherit}
section{padding:64px 0}
section.alt{background:#faf7f2}

/* Scroll reveal (CSS only, progressive enhancement) */
@keyframes riseIn{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@supports (animation-timeline: view()){
  .reveal{animation:riseIn .6s ease-out both;animation-timeline:view();animation-range:entry 0% entry 70%}
}
@media (prefers-reduced-motion:reduce){.reveal{animation:none}html{scroll-behavior:auto}}

/* Announcement bar (Fitur 5 — konten.pengumuman, tampil hanya bila aktif) */
.announce{background:var(--brand);color:#fff;text-align:center;padding:8px 16px;font-size:14px;font-weight:700}

/* Topbar + header */
.topbar{background:#111;color:#fff;font-size:13px}
.topbar .wrap{display:flex;gap:20px;flex-wrap:wrap;align-items:center;justify-content:space-between;padding-top:8px;padding-bottom:8px}
.topbar a{color:#fff;text-decoration:none;font-weight:700}
header.site{position:sticky;top:0;background:#fff;border-bottom:1px solid #e2e8f0;z-index:50}
header.site .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-top:14px;padding-bottom:14px}
.logo{display:flex;align-items:center;gap:12px;text-decoration:none}
.logo-mark{width:44px;height:44px;border-radius:10px;background:var(--brand);color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.logo-mark svg{width:26px;height:26px}
.logo b{font-size:17px;line-height:1.15;display:block}
.logo small{color:#64748b;font-size:12px;font-weight:700;letter-spacing:.08em}
nav.main{display:flex;gap:22px;align-items:center}
nav.main a{text-decoration:none;font-weight:700;font-size:15px;color:#111;white-space:nowrap}
nav.main a:hover{color:var(--brand)}
nav.main a.btn{color:#fff}
nav.main a.btn:hover{color:var(--brand)}
.btn{display:inline-block;background:var(--brand);color:#fff;border:1px solid var(--brand);border-radius:100px;padding:11px 18px;font-weight:700;text-decoration:none;text-align:center;white-space:nowrap}
.btn:hover{background:transparent;color:var(--brand)}
.btn-outline{background:#fff;color:var(--brand);border:1px solid var(--brand);border-radius:20px}
.btn-outline:hover{background:var(--brand);color:#fff}
.btn-green{background:var(--hijau);border-color:var(--hijau)}
.btn-green:hover{background:#15803d}
.menu-toggle{display:none;background:#fff;border:1px solid #cbd5e1;border-radius:8px;padding:8px 12px;font-weight:700}

/* Hero */
.hero{background:var(--navy);color:#fff;padding:56px 0;background-image:linear-gradient(90deg,rgba(15,23,42,.82),rgba(15,23,42,.40)),url("/images/hero-koper.jpg");background-size:cover;background-position:center}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:40px;align-items:center}
.hero h1{font-size:52px;margin-bottom:14px}
.hero h1 em{color:var(--aksen);font-style:normal}
.hero p.lead{color:#e2e8f0;font-size:19px;max-width:560px;margin-bottom:22px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:22px}
.hero-chips{display:flex;gap:10px;flex-wrap:wrap}
.chip{border:1px solid rgba(255,255,255,.4);background:rgba(255,255,255,.08);border-radius:999px;padding:7px 13px;font-size:13px;font-weight:700;color:#fff}
.routemap{background:#1e293b;border:1px solid #334155;border-radius:14px;padding:18px}
.routemap svg{width:100%;height:auto;display:block}
.routemap figcaption{color:#94a3b8;font-size:12px;margin-top:10px}
.route{stroke-dasharray:6 6;animation:dashmove 2.4s linear infinite}
@keyframes dashmove{to{stroke-dashoffset:-24}}
.port{fill:var(--aksen)}
.port-hub{fill:#f97316}

/* Tools */
.tools{margin-top:-28px;padding-top:0;position:relative;z-index:2}
.tools-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.tool{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:24px;box-shadow:0 8px 24px rgba(var(--navy-rgb),.08)}
.tool h3{font-size:19px;margin-bottom:4px}
.tool p{color:#444;font-size:14px;margin-bottom:16px}
.field{margin-bottom:12px}
.field label{display:block;font-weight:700;font-size:13px;margin-bottom:5px}
.field select,.field input{width:100%;border:1px solid #cbd5e1;border-radius:8px;padding:11px 12px;font:inherit;background:#fff}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.tool-result{display:none;background:#fff;border:1px solid var(--brand);border-radius:10px;padding:14px;margin-top:14px;font-size:14px}
.tool-result b{display:block;margin-bottom:4px}
.island-tag{display:inline-block;background:#f97316;color:#fff;font-size:11px;font-weight:700;letter-spacing:.06em;border-radius:999px;padding:3px 9px;margin-bottom:10px}

/* Cards */
.usp-grid,.services-grid,.testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:28px}
.card{border:1px solid #e2e8f0;border-radius:12px;padding:24px;background:#fff;transition:transform .2s ease,border-color .2s ease}
.card:hover{transform:translateY(-3px);border-color:var(--brand)}
.card h3{font-size:18px;margin:12px 0 6px}
.card p{color:#444;font-size:15px}
.icon{width:48px;height:48px;border-radius:12px;background:#fef2f2;color:var(--brand);display:flex;align-items:center;justify-content:center}
.icon svg{width:26px;height:26px}
.service{display:flex;flex-direction:column}
.service-photo{margin:-24px -24px 16px;border-radius:12px 12px 0 0;overflow:hidden}
.service-photo img{width:100%;height:150px;object-fit:cover;display:block}
.about-photo{margin-bottom:16px}
.about-photo img{width:100%;height:260px;object-fit:cover;display:block;border-radius:14px}
.about-photo figcaption{font-size:12px;color:#64748b;margin-top:8px}
.photo-note{font-size:13px;color:#64748b;margin-top:14px}
.service .cities{flex:1;margin-bottom:14px}
.service .mode{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--brand);margin-bottom:6px}
.service .btn{margin-top:auto}

/* About */
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}
.about-visual{background:var(--navy);border-radius:14px;padding:28px;color:#fff}
.about-visual h3{font-size:20px;margin-bottom:12px}
.about-visual ul{list-style:none}
.about-visual li{padding:10px 0;border-top:1px solid #334155;font-size:15px}
.about-visual li b{color:var(--aksen)}
.trust{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:20px}
.trust div{border:1px solid #e2e8f0;border-radius:10px;padding:14px;font-size:14px}
.trust b{display:block;font-size:15px;margin-bottom:2px}

/* Process */
.process{background:var(--navy);color:#fff;background-image:linear-gradient(rgba(15,23,42,.85),rgba(15,23,42,.85)),url("/images/terminal-bremerhaven.jpg");background-size:cover;background-position:center}
.process h2,.process .sub{color:#fff}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:28px}
.step{border:1px solid #334155;border-radius:12px;padding:22px;background:#1e293b}
.step b.num{font-size:28px;color:var(--aksen)}
.step h3{font-size:17px;margin:10px 0 6px}
.step p{color:#e2e8f0;font-size:14px}

/* Why */
.why-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:28px}
.why{display:flex;gap:16px}
.why h3{font-size:17px;margin-bottom:4px}
.why p{color:#444;font-size:14px}
.why-top{display:grid;grid-template-columns:1fr 1.1fr;gap:40px;align-items:center;margin-bottom:28px}
.why-pills{display:flex;flex-direction:column;gap:10px;margin-top:20px;align-items:flex-start}
.pill-red{background:var(--brand);color:#fff;border-radius:999px;padding:10px 18px;font-weight:700;font-size:15px;white-space:nowrap}
.collage{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:14px;height:480px}
.collage figure{border-radius:12px;overflow:hidden;margin:0}
.collage img{width:100%;height:100%;object-fit:cover;display:block}
.col-tall{grid-row:1/3}

/* Testimonials */
.testi .quote{font-size:15px;color:#111;margin-bottom:16px}
.who{display:flex;gap:12px;align-items:center}
.avatar{width:44px;height:44px;border-radius:50%;background:var(--brand);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0}
.who b{display:block;font-size:15px}
.who span{font-size:13px;color:#444}

/* FAQ */
.faq{max-width:800px;margin:0 auto}
.faq details{border:1px solid #e2e8f0;border-radius:10px;padding:16px 18px;margin-bottom:12px;background:#fff}
.faq summary{font-weight:700;cursor:pointer;font-size:16px}
.faq p{color:#444;margin-top:10px;font-size:15px}

/* CTA + contact */
.cta{background:var(--brand);color:#fff;text-align:center}
.cta h2{font-size:30px}
.cta p{color:#fff;max-width:640px;margin:10px auto 22px}
.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:28px}
.contact-box h3{font-size:17px;margin-bottom:8px}
.contact-box p{color:#444;font-size:15px;margin-bottom:6px}
.contact-box a{font-weight:700;color:var(--brand)}

/* Footer */
footer.site{background:#111;color:#fff;padding:48px 0 0}
.foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:32px;margin-bottom:28px}
.foot-grid h3{color:#fff;font-size:16px;margin-bottom:12px}
.foot-grid a{display:block;color:#fff;text-decoration:none;padding:3px 0;font-size:14px}
.foot-grid a:hover{color:var(--aksen)}
.foot-grid p{font-size:14px}
.bottom{background:#fff;color:#334155;border-top:1px solid #e2e8f0;padding-top:18px;padding-bottom:18px;font-size:13px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}

/* Sticky mobile CTA */
.sticky-cta{display:none;position:fixed;left:12px;right:12px;bottom:12px;z-index:70;background:var(--hijau);color:#fff;border-radius:999px;text-align:center;padding:13px;font-weight:700;text-decoration:none;box-shadow:0 8px 24px rgba(0,0,0,.3)}

@media (max-width:900px){
  .hero-grid,.about-grid,.tools-grid{grid-template-columns:1fr}
  .hero h1{font-size:34px}
  .usp-grid,.services-grid,.testi-grid{grid-template-columns:1fr 1fr}
  .steps{grid-template-columns:1fr 1fr}
  .why-grid,.contact-grid{grid-template-columns:1fr}
  .why-top{grid-template-columns:1fr}
  .collage{height:440px}
  .foot-grid{grid-template-columns:1fr}
  nav.main{display:none;position:absolute;left:0;right:0;top:100%;background:#fff;flex-direction:column;align-items:flex-start;padding:16px 20px;border-bottom:1px solid #e2e8f0;gap:14px}
  nav.main.open{display:flex}
  .menu-toggle{display:block}
  header.site .wrap{position:relative}
  header.site{top:0}
  section{padding:48px 0}
  .sticky-cta{display:block}
  body{padding-bottom:64px}
}
@media (max-width:560px){
  .usp-grid,.services-grid,.testi-grid,.steps{grid-template-columns:1fr}
  .collage{grid-template-columns:1fr;grid-template-rows:none;height:auto}
  .collage figure{height:240px}
  .col-tall{grid-row:auto}
  .field-row{grid-template-columns:1fr}
  h2{font-size:24px}
}

/* v3: hero cek ongkir widget + tarif table */
.hero-tool{background:#fff;color:#111;border-radius:12px;padding:18px 20px;margin-top:24px;box-shadow:0 14px 34px rgba(0,0,0,.35);text-align:left}
.hero-tool .island-tag{position:static;display:inline-block;margin-bottom:10px}
.hero-tabs{display:flex;gap:8px;margin-bottom:14px}
.hero-tab{flex:1;padding:11px 10px;border:2px solid var(--brand);background:#fff;color:var(--brand);font-weight:700;font-size:15px;border-radius:8px;cursor:pointer}
.hero-tab.active{background:var(--brand);color:#fff}
.hero-tool-sub{margin:0 0 14px;color:#334155;font-size:15px}
.hero-tool-grid{display:grid;grid-template-columns:140px 1fr 170px;gap:12px}
.hero-tool-grid .field label{color:#111}
.hero-tool-grid input{width:100%;color:#111}
.hero-tool-grid input:disabled{background:#f1f5f9;color:#475569}
.hero-tool-row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:14px}
.hero-tool-hint{font-size:14px;color:#475569}
.popchip{padding:7px 12px;border:1px solid #cbd5e1;background:#f8fafc;color:#111;border-radius:999px;cursor:pointer;font-size:14px}
.popchip:hover{background:#fef3c7;border-color:#f59e0b}
.suggest{position:absolute;left:0;right:0;top:calc(100% + 4px);background:#fff;border:1px solid #cbd5e1;border-radius:8px;box-shadow:0 12px 28px rgba(0,0,0,.20);z-index:30;overflow:hidden}
.suggest button{display:block;width:100%;text-align:left;padding:10px 12px;background:#fff;border:0;cursor:pointer;color:#111;font-size:15px}
.suggest button:hover{background:#fef3c7}
.suggest button span{color:#64748b;font-size:13px}
.hero-tool .tool-result{display:none;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:14px;margin-top:14px;color:#111}
.hero-tool .tool-result b{color:#111}
.opt{display:flex;justify-content:space-between;gap:12px;border:1px solid #e2e8f0;background:#fff;border-radius:8px;padding:12px;margin-top:10px}
.opt .price{font-size:20px;font-weight:800;color:var(--brand);white-space:nowrap}
.hero-tool-note{margin:12px 0 0;font-size:13px;color:#475569}
.fine{font-size:13px;color:#475569;margin-top:12px}
@media(max-width:700px){.hero-tool-grid{grid-template-columns:1fr}.hero-tab{font-size:14px}}

/* Daftar Harga page */
.tarif-table{padding:56px 0}
.tarif-table h2{margin:0 0 8px}
.tarif-group{margin-top:24px}
.tarif-group h3{margin:0 0 10px;font-size:20px}
.table-scroll{overflow-x:auto}
.tarif-table table{width:100%;border-collapse:collapse;min-width:640px}
.tarif-table th,.tarif-table td{border-bottom:1px solid #e2e8f0;padding:9px 10px;text-align:left;font-size:15px}
.tarif-table th{background:var(--navy);color:#fff}
.tarif-table td:first-child{font-weight:700}
</style>
</head>
<body style={bodyStyle}>

{peng.aktif && peng.teks && (<div class="announce">{peng.teks}</div>)}

<div class="topbar">
  <div class="wrap">
    <span>{kontak.jam}</span>
    <span>Call Center: <a href={`tel:${kontak.call_center_intl}`}>{kontak.call_center}</a> &nbsp;·&nbsp; WhatsApp: <a href={`https://wa.me/${kontak.whatsapp_umum_intl}`} target="_blank" rel="noopener">{kontak.whatsapp_umum}</a> &nbsp;·&nbsp; <a href={`mailto:${kontak.email}`}>{kontak.email}</a></span>
  </div>
</div>

<header class="site" data-astro="static" data-astro-label="STATIC · 0 JS">
  <div class="wrap">
    <a class="logo" href="/" aria-label={`${brand} — Beranda`}>
      <span class="logo-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 15l1.5-6h15L21 15M3 15h18M3 15v4h18v-4M6 19v2M18 19v2M12 9V4M12 4l-2 2M12 4l2 2"/></svg></span>
      <span><b>{brand.toUpperCase()}</b><small>{konten.tagline}</small></span>
    </a>
    <button class="menu-toggle" id="menuToggle" aria-expanded="false">Menu</button>
    <nav class="main" id="mainNav" aria-label="Navigasi utama">
      {konten.nav.map((item) => (<a href={item.href}>{item.label}</a>))}
      <a class="btn" href={waUmum} target="_blank" rel="noopener">{konten.navCta}</a>
    </nav>
  </div>
</header>

<slot />

<footer class="site" data-astro="static" data-astro-label="STATIC · 0 JS">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <h3>{brand.toUpperCase()}</h3>
        <p>{konten.footer.tagline}</p>
        <p style="margin-top:10px">Call center: {kontak.call_center}</p>
      </div>
      <div>
        <h3>Navigasi</h3>
        {konten.footer.nav.map((item) => (<a href={item.href}>{item.label}</a>))}
      </div>
      <div>
        <h3>Layanan</h3>
        {konten.services.items.map((s) => (<a href="/#layanan">{s.title}</a>))}
      </div>
    </div>
    <div class="bottom">
      <span>© {year} {brand} · CV Bina Mitra Perkasa</span>
      <span>Jakarta, Indonesia</span>
    </div>
  </div>
</footer>

<a class="sticky-cta" href={waUmum} target="_blank" rel="noopener">Chat WhatsApp — {konten.navCta}</a>

<script>

(function(){
  // Mobile menu (island-adjacent UI, tiny)
  var toggle = document.getElementById('menuToggle');
  var nav = document.getElementById('mainNav');
  toggle.addEventListener('click', function(){
    var open = nav.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  nav.querySelectorAll('a').forEach(function(a){
    a.addEventListener('click', function(){ nav.classList.remove('open'); });
  });
})();
</script>
</body>
</html>
